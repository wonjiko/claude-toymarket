#!/bin/sh
# 스테이징된 내용이 catalog/toymarket.json과 어긋난 상태로 커밋되는 것을 막는다.
#
# 설치: git config core.hooksPath .githooks
# 주의: core.hooksPath는 .git/hooks 디렉터리 전체를 대체한다. 기존에 쓰던 훅이
#       있으면 동작을 멈추므로 .githooks/ 로 함께 옮길 것.

set -e

cd "$(git rev-parse --show-toplevel)"

# PATH에 있는지만 보면 안 된다. Windows의 python3는 Microsoft Store 안내만
# 출력하고 실패하는 스텁일 수 있으므로, 실제로 실행해서 동작하는지 확인한다.
PYTHON=""
for py in python3 python py; do
    if "$py" -c "import sys" >/dev/null 2>&1; then
        PYTHON="$py"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "pre-commit: python을 찾지 못했다. 이 커밋은 검증 없이 통과한다." >&2
    echo "pre-commit: 최종 관문은 CI(.github/workflows/verify.yml)다." >&2
    exit 0
fi

# 워크트리가 아니라 인덱스를 검사한다. 워크트리를 읽으면 스테이징하지 않은
# 수정이 결과를 바꿔, 커밋될 내용과 다른 것을 검증하게 된다.
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
git checkout-index -a -f --prefix="$TMP/"

if ! "$PYTHON" "$TMP/scripts/verify_repo.py" --profile all; then
    echo >&2
    echo "pre-commit: 스테이징된 내용이 검증을 통과하지 못했다." >&2
    echo "pre-commit: 아래를 실행하고 갱신된 생성 파일을 함께 스테이징할 것." >&2
    echo "  $PYTHON scripts/verify_repo.py --profile all --fix" >&2
    exit 1
fi
