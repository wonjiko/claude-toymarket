#!/bin/sh
# 생성 파일이 catalog/toymarket.json과 어긋난 상태로 커밋되는 것을 막는다.
# 설치: git config core.hooksPath .githooks

for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1; then
        PYTHON="$py"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "pre-commit: python을 찾지 못해 검증을 건너뛴다." >&2
    exit 0
fi

if ! "$PYTHON" scripts/verify_repo.py --profile dual --quiet; then
    echo >&2
    echo "pre-commit: 검증 실패. 생성 파일을 갱신하려면 아래를 실행하고 결과를 함께 커밋한다." >&2
    echo "  $PYTHON scripts/verify_repo.py --profile dual --fix" >&2
    exit 1
fi
